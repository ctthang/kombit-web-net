<%@ Master Language="C#" %>
<%@ Import Namespace="Kombit.Samples.CH.WebsiteDemo.EmergencyFeature" %>
<%@ Import Namespace="System.Security.Claims" %>
<%@ Import Namespace="System" %>
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Emergency access — SAML sample</title>
    <link rel="stylesheet" href="<%= ResolveUrl("~/EmergencyAssets/emergency.css") %>" />
</head>
<body>
<% EmergencyPage view = (EmergencyPage)Page; %>
<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="<%= ResolveUrl("~/Default.aspx") %>"><span class="brand-mark" aria-hidden="true">!</span>SAML sample</a>
        <nav aria-label="Emergency access">
            <a href="<%= ResolveUrl("~/Default.aspx") %>">Normal application</a>
            <a href="<%= ResolveUrl("~/Emergency.aspx") %>" <% if (view.Mode == "prepare") { %>aria-current="page"<% } %>>Prepare</a>
            <a href="<%= ResolveUrl("~/EmergencyLogin.aspx") %>" <% if (view.Mode == "login") { %>aria-current="page"<% } %>>Emergency login</a>
            <a href="<%= ResolveUrl("~/EmergencyOperator.aspx") %>" <% if (view.Mode == "operator") { %>aria-current="page"<% } %>>Local operator</a>
        </nav>
    </div>
</header>
<main id="saml-emergency" data-api="<%= ResolveUrl("~/EmergencyApi.ashx") %>" data-mode="<%: view.Mode %>" data-accepting="<%: view.Accepting ? "true" : "false" %>">
    <div class="page-head">
        <h1>Emergency access</h1>
        <p class="notice"><strong>Proof of concept.</strong> Emergency access uses local key verification. It does not provide normal NSIS assurance.</p>
    </div>
    <input id="csrf" type="hidden" value="<%: view.CsrfToken %>" />
    <p id="status" role="status" aria-live="polite"></p>

<% if (view.Mode == "prepare") { %>
    <section class="card">
        <h2>Prepare this browser</h2>
        <p class="lead">Use a key with user verification and no passkey backup. Preparation has three parts: registration, browser storage, and a separate key check.</p>
        <ol class="steps">
            <li>
                <span class="step-title">Start from a recent normal login</span>
                <span class="hint">Preparation and renewal require a fresh normal login.</span>
                <a class="button secondary" href="<%= ResolveUrl("~/login.ashx?ReturnUrl=Emergency.aspx") %>">Get a new normal login</a>
            </li>
            <li>
                <span class="step-title">Register and store a key</span>
                <span class="hint"><% if (view.CanPrepare) { %>Your browser will ask for the key twice: once to register it, once to confirm it.<% } else { %>Not available yet. Get a new normal login first.<% } %></span>
                <button id="register" class="primary" type="button" <% if (!view.CanPrepare) { %>disabled<% } %>>Prepare this browser</button>
            </li>
        </ol>
    </section>
    <section class="card">
        <h2>Keys stored in this browser</h2>
        <p id="storage-note" class="hint">Clearing or evicting site data loses preparation. A different browser profile is not prepared.</p>
        <ul id="saved-keys" class="key-list"><li class="empty">Loading stored keys…</li></ul>
        <p class="hint">If issuance succeeded but storage or delivery failed, its binding can still count towards the issuer's key limit. Ask the operator to remove the binding before trying again.</p>
    </section>

<% } else if (view.Mode == "login") { %>
    <section class="card">
        <h2>Local emergency login</h2>
    <% if (view.Accepting) { %>
        <p class="lead">Select a locally stored credential. This page and the key check do not contact Identify.</p>
        <ul id="saved-keys" class="key-list"><li class="empty">Loading stored keys…</li></ul>
    <% } else { %>
        <div class="empty-state">
            <span class="badge off">Acceptance off</span>
            <p>Emergency acceptance is off. A local operator must enable it first.</p>
        </div>
    <% } %>
    </section>

<% } else if (view.Mode == "operator") { %>
    <section class="card" <% if (view.OperatorAuthenticated) { %>hidden<% } %>>
        <h2>Local operator sign-in</h2>
        <p class="lead">Operator sessions last 15 minutes. Keep the operator key outside source control.</p>
        <form id="operator-form" class="inline-form" method="post">
            <div class="field grow">
                <label for="operator-key">Operator key</label>
                <input id="operator-key" type="password" autocomplete="current-password" maxlength="512" required />
            </div>
            <button class="primary">Sign in locally</button>
        </form>
    </section>
    <div id="operator-panel" class="stack" <% if (!view.OperatorAuthenticated) { %>hidden<% } %>>
        <section class="card">
            <div class="card-head">
                <h2>Local operator</h2>
                <button id="operator-exit" class="secondary" type="button">Sign out operator</button>
            </div>
            <dl id="operator-status" class="stats"></dl>
        </section>
        <section class="card">
            <h3>Emergency acceptance</h3>
            <div class="field">
                <label for="duration">Acceptance duration in minutes</label>
                <input id="duration" type="number" min="0" max="1440" value="60" aria-describedby="duration-hint" />
                <span id="duration-hint" class="hint">0 means the window has no end.</span>
            </div>
            <div class="actions">
                <button id="enable" class="primary" type="button">Enable emergency acceptance</button>
                <button id="disable" class="danger" type="button">Stop acceptance and emergency sessions</button>
            </div>
        </section>
        <section class="card">
            <h3>Block locally</h3>
            <div class="field">
                <label for="binding-id">Binding ID</label>
                <input id="binding-id" maxlength="128" spellcheck="false" autocomplete="off" aria-describedby="binding-hint" />
                <span id="binding-hint" class="hint">Shown with each key on the preparation page.</span>
            </div>
            <label class="check"><input id="block-account" type="checkbox" /> Block all keys of the account</label>
            <div class="actions">
                <button id="block" class="danger" type="button">Apply local block</button>
            </div>
        </section>
        <section class="card">
            <h3>Explicit online synchronization</h3>
            <p class="hint">This operation contacts Identify for signing keys, central revocations, and queued key removal reports. The emergency login flow does not call it.</p>
            <div class="actions">
                <button id="sync" class="secondary" type="button">Synchronize with Identify now</button>
            </div>
        </section>
        <section class="card">
            <h3>Recent events</h3>
            <ul id="events" class="log"></ul>
        </section>
    </div>

<% } else if (view.Mode == "home") { %>
    <section class="card">
        <div class="card-head">
            <h2>Emergency session</h2>
            <button id="exit" class="secondary" type="button">Sign out locally</button>
        </div>
        <dl class="stats">
            <div><dt>Session ends</dt><dd><%: DateTimeOffset.FromUnixTimeSeconds(long.Parse(view.EmergencyUser.FindFirst("emergency_expiry").Value)).ToString("u") %></dd></div>
        </dl>
        <p class="hint">Normal SAML logout, reauthentication, STS token exchange, and token-based service calls are unavailable.</p>
    </section>
    <section class="card">
        <h3>Permitted claims</h3>
        <dl class="claims"><% foreach (Claim claim in view.EmergencyUser.Claims) { if (claim.Type != "emergency_session") { %>
            <div><dt><%: claim.Type %></dt><dd><%: claim.Value %></dd></div><% } } %>
        </dl>
    </section>

<% } else { %>
    <section class="card">
        <h2>Session ended</h2>
        <p>Your session expired or local acceptance is unavailable. A new key check is required when the operator enables access.</p>
        <div class="actions">
            <a class="button primary" href="<%= ResolveUrl("~/EmergencyLogin.aspx") %>">Go to emergency login</a>
            <a class="button secondary" href="<%= ResolveUrl("~/Default.aspx") %>">Normal application</a>
        </div>
    </section>
<% } %>

    <asp:ContentPlaceHolder ID="Body" runat="server" />
    <noscript><p class="notice">JavaScript, IndexedDB, and WebAuthn are required.</p></noscript>

    <details id="issuer-diagnostics" class="card">
        <summary>Identify endpoint results (PoC)</summary>
        <p class="hint">Results from this browser tab only. Up to 8 latest Identify calls per action and 40 recent entries are shown. Bodies, keys, tokens, and personal claims are omitted. HTTP success alone does not mean preparation or login succeeded.</p>
        <button id="clear-issuer-diagnostics" class="secondary small" type="button">Clear displayed history</button>
        <ol id="issuer-call-results" class="log"></ol>
    </details>
</main>
<script src="<%= ResolveUrl("~/EmergencyAssets/emergency.js") %>" defer></script>
</body>
</html>
